{
  "version": 2,
  "name": "made-in-tanzania",
  "buildCommand": null,
  "outputDirectory": "website",
  "routes": [
    {
      "src": "/projects.json",
      "headers": {
        "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400",
        "Access-Control-Allow-Origin": "*"
      },
      "dest": "/projects.json"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
